rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(bottleId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/botellas/$(bottleId)/members/$(request.auth.uid));
    }

    match /exports/{bottleId}/excel/{fileName} {
      allow read: if isMember(bottleId);
      allow write: if isMember(bottleId) && request.resource.size < 20 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
